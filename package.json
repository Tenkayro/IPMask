{
  "name": "ipmask",
  "version": "26.1.0",
  "private": true,
  "description": "Client-side Fabric privacy mod that masks server addresses in Minecraft text, menus, chat, signs, and tooltips.",
  "scripts": {
    "build": "gradlew.bat build",
    "clean": "gradlew.bat clean",
    "release": "node scripts/release.mjs",
    "start": "gradlew.bat runClient",
    "start:offline": "gradlew.bat --offline runClient",
    "start:modmenu": "gradlew.bat -PwithModMenu runClient",
    "test": "gradlew.bat test"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0"
  }
}
