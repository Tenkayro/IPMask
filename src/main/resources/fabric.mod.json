{
  "schemaVersion": 1,
  "id": "ipmask",
  "version": "${version}",
  "name": "IPMask",
  "description": "Hide server IPs in your server list and never leak them again.",
  "authors": [
    "Tenkayro"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/ipmask",
    "sources": "https://github.com/Tenkayro/IPMask",
    "issues": "https://github.com/Tenkayro/IPMask/issues"
  },
  "license": "MIT",
  "icon": {
    "128": "assets/ipmask/icon-128.png",
    "512": "assets/ipmask/icon.png"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "tenkayro.ipmask.client.IPMaskClient"
    ]
  },
  "mixins": [
    {
      "config": "ipmask.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "client"
      ],
      "links": {
        "ipmask.modrinth": "https://modrinth.com/mod/ipmask",
        "ipmask.sources": "https://github.com/Tenkayro/IPMask",
        "ipmask.issues": "https://github.com/Tenkayro/IPMask/issues"
      },
      "update_checker": false
    }
  }
}
